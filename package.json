{
  "name": "multiai-chat",
  "displayName": "Multi AI Chat",
  "description": "OpenAI / Gemini など複数プロバイダー対応のチャット拡張機能",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
  "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "multiai-chat.openChat",
        "title": "Multi AI Chat: チャットウィンドウを開く"
      },
      {
        "command": "multiai-chat.sendSelection",
        "title": "Multi AI Chat: 選択内容をAIに送る"
      },
      {
        "command": "multiai-chat.showLogs",
        "title": "Multi AI Chat: Show Logs"
      }
    ],
    "configuration": {
      "title": "Multi AI Chat",
      "properties": {
        "multiai-chat.provider": {
          "type": "string",
          "enum": ["openai", "gemini"],
          "default": "openai",
          "description": "AI プロバイダー (選択: openai, gemini)"
        },
        "multiai-chat.apiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API Key"
        },
        "multiai-chat.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Google Gemini API Key"
        },
        "multiai-chat.apiEndpoint": {
          "type": "string",
          "default": "api.openai.com",
          "description": "OpenAI API エンドポイント (例: api.openai.com, your-azure-instance.openai.azure.com)"
        },
        "multiai-chat.geminiCustomUrl": {
          "type": "string",
          "default": "",
          "description": "必須: Gemini のフル URL。例: https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent または ...:streamGenerateContent?alt=sse"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "dependencies": {
    "openai": "^6.15.0"
  }
}
